{
  "manifest_version": 3,
  "name": "MarginNote",
  "version": "0.1.0",
  "description": "Highlight and take notes on any web page, then find them again later.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MarginNote"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
